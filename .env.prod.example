# Production environment variables for docker-compose.prod.yml
# Copy to `.env` in the repo root and fill in real values before deploying.
# Compose will now refuse to start (fail loudly) if any of these are missing —
# there are no insecure fallback defaults.

# --- Database ---
POSTGRES_USER=rework_user
POSTGRES_PASSWORD=   # generate a strong random password, e.g. `openssl rand -hex 24`
POSTGRES_DB=rework_db

# --- Auth ---
JWT_SECRET=   # generate with: openssl rand -hex 32

# --- Public URLs (must match your real domain/deployment) ---
FRONTEND_URL=https://your-domain.example
BACKEND_URL=https://api.your-domain.example
BACKEND_CORS_ORIGINS=https://your-domain.example
WEBSOCKET_ALLOWED_ORIGINS=https://your-domain.example

# --- Frontend build-time vars (used by docker-compose.prod.yml build args) ---
NEXT_PUBLIC_API_URL=https://api.your-domain.example
NEXT_PUBLIC_WS_URL=wss://api.your-domain.example
